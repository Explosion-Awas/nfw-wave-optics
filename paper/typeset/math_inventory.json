  {
    "tex": "\n \\boxed{A_-=A_{\\Gamma_r}-\\frac{2i}{\\pi}J_-^{0,r}.}         \\tag{A.27}\n",
    "displayMode": true
  },
  {
    "tex": "\n \\begin{split}\n F&=I_{\\Gamma_r}+\\frac{w}{\\pi}e^{iw\\tau_c}\n                  \\left[J_+^{0,\\infty}-J_-^{0,r}\\right]\\\\\n  &=I_{\\Gamma_r}+\\frac{w}{\\pi}e^{iw\\tau_c}\n       \\left[J_+^{0,\\infty}-J_-^{0,\\infty}+J_-^{r,\\infty}\\right].\n \\end{split}                                                \\tag{A.28}\n",
    "displayMode": true
  },
  {
    "tex": "\n |T_r|\\leq\\frac{w}{\\pi}\\int_r^\\infty tK_0(qt)dt\n          =\\frac{wr}{\\pi q}K_1(qr).                        \\tag{A.29}\n",
    "displayMode": true
  },
  {
    "tex": "\n L_r:\\ z=r+(1+i)u,\\quad-\\infty<u<\\infty,\\qquad\n I_{L_r}=-\\frac{iw}{2}e^{iw\\tau_c}\\int_{L_r}f_-(z)dz.        \\tag{A.30}\n",
    "displayMode": true
  },
  {
    "tex": "\n C R^{3/2}e^{-qR/\\sqrt2}\\longrightarrow0.                  \\tag{A.31}\n",
    "displayMode": true
  },
  {
    "tex": "\n \\int_{-i\\infty}^{-ir}f_-(z)dz=\\frac{2i}{\\pi}J_-^{r,\\infty},\n \\qquad\n \\boxed{I_{L_r}-I_{\\Gamma_r}=e^{iw\\tau_c}T_r.}             \\tag{A.32}\n",
    "displayMode": true
